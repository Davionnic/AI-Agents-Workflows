# LLM provider: openai or ollama
LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Web search provider: firecrawl or serper
WEB_SEARCH_PROVIDER=firecrawl

# Firecrawl (required when WEB_SEARCH_PROVIDER=firecrawl)
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Serper (required when WEB_SEARCH_PROVIDER=serper)
SERPER_API_KEY=your_serper_api_key
